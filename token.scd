FUNC 0x01 (2) ; минтинг токена, 1 аргумент сумма, 2 аргумент адрес
GET_SPECIAL 0x04, R1 ; получаем адрес
CMP R1, 0x1234567890123456789012345678901234567890 ; адрес для примера
JE 6 ; прыг на строку 6
REVERT
SLOAD R1, R1  ; получение баланса этого адреса
ADD S0, R1    ; результат в R1
SSTORE S1, R1 ; сохраняем на этот адрес
RET 1         ; возращение что все прошло успешно

FUNC 0x02 (2) ; перевод, 1 аргумент сумма, 2 аргумент адрес
GSPEC 0x01, R1 ; получаем адрес
SLOAD R1, R2 ; получаем баланс
CMH R2, S0 ; сравниваем, если баланс больше суммы перевода то разрешаем
JE 19
CMP R2, S0 ; вдруг баланс равен сумме перевода
JE 19
REVERT ; отменяем транзакцию если меньше суммы перевода
MOV S0, R3 ; копируем
SUB R2, R3 ; вычитаем
SSTORE R1, R3 ; сохраняем уменьшенный баланс отправителя
SLOAD S1, R4 ; загружаем баланс получателя
ADD S0, R4 ; складываем сумму перевода с балансом
SSTORE S1, R4 ; сохраняем
RET 1 ; говорим что все прошло успешно