FUNC 0x2 (recipient, sum) {
    address = GSPEC() // получаем адрес
    bal = SLOAD(address)
    bal > sum
    JE .ok
    bal == sum
    JE .ok
    REVERT
    .ok:
        recipient_bal = SLOAD(recipient)
        bal -= sum
        SSTORE(address, bal)
        recipient_bal += sum
        SSTORE(recipient, recipient_bal)
        RET 1
}